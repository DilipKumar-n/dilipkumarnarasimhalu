# LinkedIn Developer App: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Access token from OAuth callback or Developer Portal token generator
LINKEDIN_ACCESS_TOKEN=

# Optional: refresh token for long-lived access
LINKEDIN_REFRESH_TOKEN=

# Optional: map recommender person IDs to display names (from API response)
# Example: {"abc123":{"author":"Jatin Waichal","designation":"Solutions Architect","linkedinUsername":"jatin-waichal"}}
LINKEDIN_RECOMMENDER_OVERRIDES=
